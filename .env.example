# =============================================================================
# Apna Store — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# JWT
# Must be at least 64 ASCII characters for HMAC-SHA-256 security.
# Generate with: openssl rand -hex 64
# -----------------------------------------------------------------------------
APNASTORE_JWT_SECRET=replace-with-a-random-64-char-string-never-commit-the-real-value

# JWT token lifetime in milliseconds.
# 86400000 = 24 hours. Reduce for higher security (e.g. 3600000 = 1 hour).
APNASTORE_JWT_EXPIRY_MS=86400000

# -----------------------------------------------------------------------------
# Admin seed account (dev/staging only)
# Set a strong password. Leave empty in production; create admins via DB directly.
# -----------------------------------------------------------------------------
ADMIN_SEED_PASSWORD=replace-with-a-strong-admin-password
